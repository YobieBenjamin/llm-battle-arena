{
  "name": "llm-battle-arena",
  "version": "2.0.0",
  "description": "One prompt. Three perspectives. A private desktop LLM comparison app.",
  "main": "desktop/main.cjs",
  "type": "module",
  "license": "MIT",
  "author": "Yobie Benjamin",
  "repository": "https://github.com/yobieben/llm-battle-arena",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac zip"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.yobieben.llmbattlearena",
    "productName": "LLM Battle Arena",
    "files": [
      "desktop/**",
      "src/**",
      "index.html",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
