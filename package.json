{
  "name": "llm-battle-arena",
  "version": "2.4.1",
  "description": "One prompt. Three perspectives. A private desktop LLM comparison app.",
  "main": "desktop/main.cjs",
  "type": "module",
  "license": "MIT",
  "author": "Yobie Benjamin",
  "repository": "https://github.com/YobieBenjamin/llm-battle-arena",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "test:ui": "node scripts/smoke.cjs && node scripts/audit-regressions.cjs && node scripts/performance.cjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.62.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.yobieben.llmbattlearena",
    "productName": "LLM Battle Arena",
    "files": [
      "desktop/**",
      "src/**",
      "index.html",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "artifactName": "LLM-Battle-Arena-Windows-${arch}-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "linux": {
      "target": "AppImage"
    },
    "portable": {
      "artifactName": "LLM-Battle-Arena-Windows-${arch}-Portable.${ext}"
    },
    "dmg": {
      "artifactName": "LLM-Battle-Arena-macOS-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/YobieBenjamin/llm-battle-arena#readme",
  "bugs": {
    "url": "https://github.com/YobieBenjamin/llm-battle-arena/issues"
  },
  "productName": "LLM Battle Arena",
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  }
}
